<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Facturas pendientes de llevar a QuickBooks (y reintentos con espera). -->
    <record id="cron_qbo_push_invoices" model="ir.cron">
        <field name="name">QuickBooks: send pending invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._qbo_cron_push()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
