<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Facturas pendientes de llevar a QuickBooks (y reintentos con espera). -->
    <record id="cron_qbo_push_invoices" model="ir.cron">
        <field name="name">QuickBooks: send pending invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._qbo_cron_push()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
    <!-- Cobros de QuickBooks: avisos del webhook y, de respaldo, los cambios
         desde la ultima vez (CDC). -->
    <record id="cron_qbo_payments" model="ir.cron">
        <field name="name">QuickBooks: receive payments</field>
        <field name="model_id" ref="model_indigo_qbo_event"/>
        <field name="state">code</field>
        <field name="code">model._qbo_cron_payments()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
